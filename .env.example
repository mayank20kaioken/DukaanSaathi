# DukaanSaathi Environment Configuration

# TinyFish AI Web Agent API Key
# Obtain your key from TinyFish AI (https://tinyfish.ai)
# This key is strictly accessed by the server-side proxy middleware.
# Do NOT prefix with VITE_ to ensure it is never exposed in browser client bundles.
TINYFISH_API_KEY=your_tinyfish_api_key_here
